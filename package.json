{
  "name": "referral-demo",
  "private": true,
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "api:format:check": "pnpm --filter api format:check",
    "api:lint": "pnpm --filter api lint",
    "api:typecheck": "pnpm --filter api typecheck",
    "api:test:cov": "pnpm --filter api test:cov",
    "api:test:e2e": "pnpm --filter api test:e2e",
    "api:build": "pnpm --filter api build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "verify": "pnpm lint && pnpm test && pnpm build && pwsh -File scripts/Validate-ProjectHarness.ps1 && pwsh -File scripts/Verify-Architecture.ps1"
  }
}
